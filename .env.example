PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Set to "true" while developing — logs WhatsApp sends instead of calling Meta
MOCK_WHATSAPP=true

# Meta WhatsApp Cloud API (official) — only needed when MOCK_WHATSAPP=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=event_checkin_confirmation

# Public base URL used to build each event's QR link
PUBLIC_BASE_URL=http://localhost:4000
